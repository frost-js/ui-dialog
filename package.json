{
    "name": "@fr0st/ui-dialog",
    "version": "2.0.0",
    "private": false,
    "description": "Programmatic alert, confirmation, and custom modal dialogs for Frost UI.",
    "keywords": [
        "alert",
        "component",
        "confirmation",
        "dialog",
        "frost",
        "frontend",
        "javascript",
        "modal",
        "ui"
    ],
    "homepage": "https://github.com/frost-js/ui-dialog",
    "bugs": {
        "url": "https://github.com/frost-js/ui-dialog/issues",
        "email": "elusivecodes@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/frost-js/ui-dialog.git"
    },
    "license": "MIT",
    "author": "Elusive <elusivecodes@gmail.com>",
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/frost-ui-dialog.esm.js",
            "default": "./dist/frost-ui-dialog.esm.js"
        },
        "./dist/*": "./dist/*",
        "./src/*": "./src/*"
    },
    "main": "./dist/frost-ui-dialog.esm.js",
    "jsdelivr": "./dist/frost-ui-dialog.min.js",
    "unpkg": "./dist/frost-ui-dialog.min.js",
    "module": "./dist/frost-ui-dialog.esm.js",
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "src"
    ],
    "scripts": {
        "build": "vite build && vite build --mode umd",
        "lint": "eslint",
        "test": "npm run build && npm run test:browser",
        "test:browser": "playwright test --forbid-only",
        "test:coverage": "playwright test --config=playwright.coverage.config.js --forbid-only",
        "test:headed": "playwright test --forbid-only --headed",
        "test:ui": "playwright test --ui"
    },
    "browserslist": [
        "baseline newly available"
    ],
    "devDependencies": {
        "@fr0st/eslint-config": "^5.0.3",
        "@fr0st/query": "^4.1.2",
        "@fr0st/ui": "^3.0.2",
        "@playwright/test": "^1.62.1",
        "eslint": "^10.9.1",
        "monocart-reporter": "^2.12.6",
        "vite": "^8.2.2"
    },
    "peerDependencies": {
        "@fr0st/query": "^4.1.2",
        "@fr0st/ui": "^3.0.0"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "publishConfig": {
        "access": "public"
    }
}
